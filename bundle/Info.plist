<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LocalShare</string>
    <key>CFBundleDisplayName</key>
    <string>LocalShare</string>
    <key>CFBundleExecutable</key>
    <string>LocalShare</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>live.ezze.localshare</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>

    <!-- ===== Sparkle 自动更新 ===== -->
    <!-- appcast 源：CI 发版时把 appcast.xml 作为 Release 资产上传；此地址由 GitHub 保证
         恒指向最新 release 的同名资产，无需向仓库写任何东西。≤0.6.0 的老客户端仍读
         raw master 的 appcast.xml，迁移说明见 CLAUDE.md「发布与版本」。 -->
    <key>SUFeedURL</key>
    <string>https://github.com/rrbe/LocalShare/releases/latest/download/appcast.xml</string>
    <!-- EdDSA 公钥：更新包用对应私钥签名、此处校验。⚠️ 发布前必须用 Sparkle 的 generate_keys
         生成并替换占位值（私钥进 GitHub secret SPARKLE_ED_PRIVATE_KEY）。占位时 app 不启动 updater。 -->
    <key>SUPublicEDKey</key>
    <string>yF0fhsSuotJutGHezmoAFb3+M7nA6gcOln5aEWycXp8=</string>
    <!-- 自动后台检查：跳过首启「是否自动检查更新」询问，直接启用。 -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- 检查间隔（秒）：每天一次。 -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- 不静默安装：发现新版只弹提示，由用户确认后再下载安装。 -->
    <key>SUAutomaticallyUpdate</key>
    <false/>
</dict>
</plist>
